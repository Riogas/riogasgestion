.env
.env.local
.env.development
.env.test
.env*.local

# IDEs y editores
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Scripts de deploy
deploy.sh
webhook-deploy.sh
*.sh

# Logs
logs/
*.log

# Documentación
README.md
README-DEPLOY.md
MIDDLEWARE_README.md
*.md

# Archivos temporales
tmp/
temp/
*.tmp

# Archivos de sistema
Thumbs.db
.DS_Store

