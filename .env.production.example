# ============================================
# VARIABLES DE ENTORNO - PRODUCCIÓN
# ============================================
# Copia este archivo a .env.production y 
# configura los valores reales
# ============================================

# ============================================
# SENTRY CONFIGURATION
# DSN obtenido desde Sentry.io
# ============================================
NEXT_PUBLIC_SENTRY_DSN=https://a38b0b3d30c9a61aee05888309680ce0@o4509684235436032.ingest.us.sentry.io/4509684267155456
SENTRY_DSN=https://a38b0b3d30c9a61aee05888309680ce0@o4509684235436032.ingest.us.sentry.io/4509684267155456

# Sentry Organization and Project (para builds)
SENTRY_ORG=riogas
SENTRY_PROJECT=goya

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ============================================
# DEBUG (Descomentar solo para debugging)
# ============================================
# DEBUG_MW=1

# ============================================
# BACKEND API
# IMPORTANTE: Cambiar por la IP/dominio real
# ============================================
NEXT_PUBLIC_API_URL=http://192.168.1.72:8082

# ============================================
# SEGURIDAD - JWT SECRETS
# IMPORTANTE: Generar con: openssl rand -base64 32
# ============================================
JWT_SECRET=CAMBIAR-generar-con-openssl-rand-base64-32
NEXTAUTH_SECRET=CAMBIAR-generar-otro-diferente-con-openssl

# ============================================
# API DE PERMISOS
# IMPORTANTE: Cambiar por la IP/dominio real
# ============================================
PERMISOS_API_URL=http://192.168.1.72:8082/servicios/SecuritySuite/Permisos

# ============================================
# APLICACIÓN
# ============================================
NEXT_PUBLIC_APLICACION_ID=3

# ============================================
# CHAT API (n8n)
# IMPORTANTE: Cambiar por la IP/dominio real
# ============================================
NEXT_PUBLIC_CHAT_API_URL=http://localhost:5678
NEXT_PUBLIC_CHAT_ENDPOINT=/webhook/ai-chat

# ============================================
# COORDENADAS DEL MAPA (GOYA, CORRIENTES)
# ============================================
NEXT_PUBLIC_DEFAULT_LAT=-27.4606
NEXT_PUBLIC_DEFAULT_LNG=-58.8341
NEXT_PUBLIC_DEFAULT_ZOOM=13

# ============================================
# ZONA HORARIA
# ============================================
TZ=America/Argentina/Buenos_Aires
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Discord webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# ============================================
# OTROS
# ============================================
# Zona horaria
TZ=America/Argentina/Buenos_Aires

# Locale
LANG=es_AR.UTF-8

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000
