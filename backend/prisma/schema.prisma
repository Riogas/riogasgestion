// Prisma schema — base goya (192.168.2.117). Nueva estructura canónica.
// Modelo Cliente: espejo limpio de GXCALDTA.CLIENTE (AS400/DB2), sin campos AUX.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  // PK = CLIID del AS400 (no autogenerado, se importa con su id original)
  id Int @id

  // Datos del cliente
  nombre                    String?   @db.VarChar(60) // CLINOM
  ruc                       String?   @db.VarChar(12) // CLIRUC (DEC(12) en origen)
  observaciones             String?   @db.VarChar(200) // CLIOBS
  email                     String?   @db.VarChar(60) // CLIMAIL
  estado                    String?   @db.VarChar(1) // CLIESTADO (código)
  nroGci                    String?   @db.VarChar(6) // CLIGCINRO
  vip                       Boolean? // CLIVIP (0/1)
  observacionesComerciales  String?   @db.VarChar(80) // CLIOBSCOM

  // Fechas (CHAR(8) YYYYMMDD en origen → convertidas en el ETL)
  fechaAlta            DateTime? @db.Date // CLIFCHALTA
  fecha                DateTime? @db.Date // CLIFCH
  fechaGeolocalizacion DateTime? @db.Date // DIRFCHGEO
  fechaUltimaLlamada   DateTime? // CLIULTLLAM (TIMESTMP real)

  // Dirección
  numeroPuerta           Int?     // NROPUERTA
  bis                    String?  @db.VarChar(1) // BIS
  apartamento            String?  @db.VarChar(5) // APTO
  blockSolar             String?  @db.VarChar(4) // BLOCKSOL
  nivel                  String?  @db.VarChar(4) // NIVEL
  local                  String?  @db.VarChar(4) // LOCAL
  numeroManzana          String?  @db.VarChar(5) // NROMANZ
  km                     Decimal? @db.Decimal(6, 3) // KM
  observacionesDireccion String?  @db.VarChar(60) // DIROBS
  calleEsquina1Id        Int?     // CALESQ1ID
  calleEsquina2Id        Int?     // CALESQ2ID
  callePrincipalId       Int?     // CALPRINID

  // Geolocalización
  coordenadaX    Decimal? @db.Decimal(13, 5) // DIRCORX
  coordenadaY    Decimal? @db.Decimal(13, 5) // DIRCORY
  sadCoordenadaX Decimal? @db.Decimal(13, 9) // SADCORX
  sadCoordenadaY Decimal? @db.Decimal(13, 9) // SADCORY
  sadAsignadoMovil String? @db.VarChar(1)    // SADASIMOVM
  icaCoordenadaX Decimal? @db.Decimal(13, 5) // DIRICAX
  icaCoordenadaY Decimal? @db.Decimal(13, 5) // DIRICAY
  icaMetodo      Int?     // ICAMET
  icaSourceId    Int?     // ICASRCID
  icaSourceCodigo Int?    // ICASRCOD
  icaPosA        Decimal? @db.Decimal(10, 8) // ICAPOSA
  icaSofDg       Int?     // ICASOFDG

  // Clasificación / referencias
  tipoId         Int? // CLITPOPID
  zona           Int? // CLIZONA
  radio          Int? // CLIRADIO
  ultimoPedidoId Int? // CLIPEDID
  tipoServicioId Int? // CLISERVTID

  // Auditoría operadores (GeneXus)
  operadorAlta         String? @db.VarChar(15) // CLIOPINS
  operadorModificacion String? @db.VarChar(15) // CLIOPUPD

  // Verificación de coordenadas / geoinversa (feature 2026-06-23)
  direccion        String?  @db.VarChar(300) // dirección completa reconstruida (calle+nº+esquinas+solar+km+…)
  calleGeo         String?  @db.VarChar(150) // calle según geoinversa (Nominatim)
  numeroPuertaGeo  String?  @db.VarChar(30)  // nº de puerta según geoinversa
  localidadGeo     String?  @db.VarChar(120) // ciudad/localidad geoinversa
  departamentoGeo  String?  @db.VarChar(120) // estado/departamento geoinversa
  cpGeo            String?  @db.VarChar(20)  // código postal geoinversa
  calleMatch       Boolean? // ✅/❌: la calle geoinversa coincide con la que tenía
  matchScore       Float?   // similitud 0-1 (debug)
  geoLat           Decimal? @db.Decimal(10, 7) // coord usada (WGS84 lat)
  geoLng           Decimal? @db.Decimal(10, 7) // coord usada (WGS84 lon)
  geoFuente        String?  @db.VarChar(10)  // sad | ica | dircor
  geoVerificadoAt  DateTime? // cuándo se corrió la geoinversa

  // Metadatos locales (no vienen de GeneXus)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nombre])
  @@index([estado])
  @@index([zona])
  @@index([calleMatch])
  @@map("cliente")
}

// Catálogo de calles (espejo de GXCALDTA.CALLE del AS400). Para resolver
// callePrincipalId / calleEsquinaNId → nombre, y reconstruir la dirección.
model Calle {
  id        Int     @id // CALID
  nombre    String? @db.VarChar(150) // CALNOM
  nombreIca String? @db.VarChar(150) // CALNOMICA
  createdAt DateTime @default(now())

  @@map("calle")
}

// =====================================================================
// MODELO UNIFICADO DE CLIENTES (interior + capital) — spec 2026-06-24
// Tablas nuevas alongside; el slim se llama cliente_uni hasta el plan de front.
// =====================================================================

model ClienteUni {
  id                   Int       @id @default(autoincrement())
  origen               String    @db.VarChar(10) // 'interior' | 'capital'
  idOriginal           Int                       // CLIID del AS400
  nombre               String?   @db.VarChar(60)
  ruc                  String?   @db.VarChar(12)
  cedula               String?   @db.VarChar(12) // NUEVO, nullable
  email                String?   @db.VarChar(60)
  estado               String?   @db.VarChar(1)
  tipoClienteId        Int?
  vip                  Boolean?
  observaciones        String?   @db.VarChar(200)
  observacionesComerc  String?   @db.VarChar(80)
  puntosSaldo          Int?
  fleteCobra           String?   @db.VarChar(2)
  fleteCantidad        String?   @db.VarChar(2)
  categoriaPrecioId    Int?
  tipoServicioId       Int?
  gciNro               String?   @db.VarChar(6)
  fechaAlta            DateTime?
  ultimaLlamada        DateTime?
  operadorAlta         String?   @db.VarChar(15)
  operadorModificacion String?   @db.VarChar(15)
  dedupGrupo           Int?
  dedupRevisar         Boolean?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  telefonos   ClienteTelefono[]
  direcciones ClienteDireccion[]

  @@unique([origen, idOriginal])
  @@index([nombre])
  @@index([ruc])
  @@index([cedula])
  @@index([estado])
  @@map("cliente_uni")
}

model ClienteTelefono {
  id        Int        @id @default(autoincrement())
  clienteId Int
  numero    String     @db.VarChar(20)
  tipo      String?    @db.VarChar(2)
  estado    String?    @db.VarChar(1)
  alias     String?    @db.VarChar(60)
  obs       String?    @db.VarChar(60)
  principal Boolean    @default(false)
  cliente   ClienteUni @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([numero])
  @@map("cliente_telefono")
}

model ClienteDireccion {
  id              Int        @id @default(autoincrement())
  clienteId       Int
  puestoId        Int?
  departamentoId  Int?
  localidadId     Int?
  direccion       String?    @db.VarChar(300)
  calle           String?    @db.VarChar(150)
  nro             String?    @db.VarChar(40)
  esquina1        String?    @db.VarChar(150)
  esquina2        String?    @db.VarChar(150)
  bis             String?    @db.VarChar(1)
  apto            String?    @db.VarChar(40)
  blockSolar      String?    @db.VarChar(40)
  nivel           String?    @db.VarChar(40)
  local           String?    @db.VarChar(40)
  nroLocal        String?    @db.VarChar(40)
  manzana         String?    @db.VarChar(40)
  km              String?    @db.VarChar(40)
  observaciones   String?    @db.VarChar(60)
  lat             Decimal?   @db.Decimal(10, 7)
  lng             Decimal?   @db.Decimal(10, 7)
  geoFuente       String?    @db.VarChar(10)
  calleMatch      Boolean?
  geoVerificadoAt DateTime?
  cantGarrafas    Int?
  usoGarrafa      String?    @db.VarChar(40)
  tipoProducto    String?    @db.VarChar(1)
  principal       Boolean    @default(false)
  estado          String?    @db.VarChar(1)
  cliente         ClienteUni @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([puestoId])
  @@index([departamentoId, localidadId])
  @@index([calleMatch])
  @@map("cliente_direccion")
}

model Puesto {
  id             Int      @id
  nombre         String?  @db.VarChar(40)
  direccion      String?  @db.VarChar(100)
  departamentoId Int?
  zonaId         Int?
  fleteCobra     String?  @db.VarChar(2)
  fleteCantidad  String?  @db.VarChar(2)
  autopedido     String?  @db.VarChar(1)
  horarios       String?  @db.VarChar(200)
  mail           String?  @db.VarChar(100)
  propio         String?  @db.VarChar(1)
  lat            Decimal? @db.Decimal(12, 7)
  lng            Decimal? @db.Decimal(12, 7)
  estado         String?  @db.VarChar(1)

  @@map("puesto")
}

model Departamento {
  id     Int     @id
  nombre String? @db.VarChar(60)
  estado String? @db.VarChar(1)

  @@map("departamento")
}

model Localidad {
  id             Int      @id
  departamentoId Int?
  nombre         String?  @db.VarChar(60)
  lat            Decimal? @db.Decimal(10, 5)
  lng            Decimal? @db.Decimal(10, 5)
  estado         String?  @db.VarChar(1)

  @@index([departamentoId])
  @@map("localidad")
}

model TipoCliente {
  id          Int     @id
  descripcion String? @db.VarChar(60)
  estado      String? @db.VarChar(1)

  @@map("tipo_cliente")
}

model CategoriaPrecio {
  id       Int     @id @default(autoincrement())
  puestoId Int?
  catId    Int?
  nombre   String? @db.VarChar(40)
  activo   String? @db.VarChar(1)

  @@index([puestoId, catId])
  @@map("categoria_precio")
}

model Zona {
  id            Int     @id
  puestoId      Int?
  nombre        String? @db.VarChar(30)
  fleteCobra    String? @db.VarChar(2)
  fleteCantidad String? @db.VarChar(2)
  estado        String? @db.VarChar(1)

  @@index([puestoId])
  @@map("zona")
}
